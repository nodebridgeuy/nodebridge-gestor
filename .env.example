# Copiar este archivo como ".env" (en esta misma carpeta) y completar los valores.

# --- Conexión con el portal informativo ---
# Dirección del backend del portal (en XAMPP, con el portal en la misma máquina):
PORTAL_URL=http://localhost/portal-backend
# La MISMA clave que tiene el portal en su archivo portal-backend/.env (API_KEY):
PORTAL_API_KEY=

# --- Opcionales (por defecto funciona con los valores de XAMPP) ---
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=sigsm
# DB_USER=root
# DB_PASS=
# MAX_UPLOAD_MB=10
# UPLOADS_DIR=
# BASE_URL=
